{
  "name": "@priemskiyyy/scout-opensearch",
  "version": "0.1.0",
  "description": "OpenSearch adapter for Scout: the portable filter as a JSON bool query, sorts, facets as terms aggregations, per search highlight markers parsed into safe parts, and honest totals.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/scout.git",
    "directory": "packages/adapters/opensearch"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/scout/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project opensearch"
  },
  "keywords": [
    "search",
    "full-text-search",
    "opensearch",
    "facets",
    "filters",
    "highlighting",
    "typescript",
    "scout",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/scout/",
  "peerDependencies": {
    "@priemskiyyy/scout": ">=0.1.0 <0.2",
    "@opensearch-project/opensearch": ">=3 <4"
  },
  "devDependencies": {
    "@priemskiyyy/scout": "workspace:*",
    "@priemskiyyy/scout-elastic-dsl": "workspace:*"
  }
}
