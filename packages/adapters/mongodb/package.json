{
  "name": "@priemskiyyy/scout-mongodb",
  "version": "0.1.0",
  "description": "MongoDB Search adapter for Scout: the portable filter as a compound $search, sorts, facets through $$SEARCH_META, highlights as safe parts, and honest totals.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/scout.git",
    "directory": "packages/adapters/mongodb"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/scout/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project mongodb"
  },
  "keywords": [
    "search",
    "full-text-search",
    "mongodb",
    "atlas-search",
    "mongodb-search",
    "facets",
    "filters",
    "highlighting",
    "typescript",
    "scout",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/scout/",
  "peerDependencies": {
    "@priemskiyyy/scout": ">=0.1.0 <0.2",
    "mongodb": ">=7 <8"
  },
  "devDependencies": {
    "@priemskiyyy/scout": "workspace:*"
  }
}
