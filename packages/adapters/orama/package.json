{
  "name": "@priemskiyyy/scout-orama",
  "version": "0.1.0",
  "description": "Orama adapter for Scout: the portable keyword subset of a local in-process corpus, exact totals and facets, and the corpus revision folded into the query identity.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/scout.git",
    "directory": "packages/adapters/orama"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/scout/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project orama"
  },
  "keywords": [
    "search",
    "full-text-search",
    "orama",
    "local-search",
    "offline-search",
    "facets",
    "filters",
    "typescript",
    "scout",
    "tanstack-query",
    "react-native"
  ],
  "homepage": "https://priemskiyyy.github.io/scout/",
  "peerDependencies": {
    "@orama/orama": ">=3 <4",
    "@priemskiyyy/scout": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/scout": "workspace:*"
  }
}
