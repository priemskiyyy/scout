{
  "name": "@priemskiyyy/scout-meilisearch",
  "version": "0.1.0",
  "description": "Meilisearch adapter for Scout: filter translation, honest totals, and safe highlight parts behind the portable search contract.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/scout.git",
    "directory": "packages/adapters/meilisearch"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/scout/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project meilisearch"
  },
  "keywords": [
    "search",
    "full-text-search",
    "meilisearch",
    "facets",
    "filters",
    "highlighting",
    "typescript",
    "scout",
    "tanstack-query",
    "react-native"
  ],
  "homepage": "https://priemskiyyy.github.io/scout/",
  "peerDependencies": {
    "@priemskiyyy/scout": ">=0.1.0 <0.2",
    "meilisearch": ">=0.50 <1"
  },
  "devDependencies": {
    "@priemskiyyy/scout": "workspace:*"
  }
}
