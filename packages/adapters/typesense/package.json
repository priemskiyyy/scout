{
  "name": "@priemskiyyy/scout-typesense",
  "version": "0.1.0",
  "description": "Typesense adapter for Scout: exact filter_by translation, per search highlight markers parsed into safe parts, honest totals and facet exhaustiveness, and cancellation on the wire.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/scout.git",
    "directory": "packages/adapters/typesense"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/scout/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project typesense"
  },
  "keywords": [
    "search",
    "full-text-search",
    "typesense",
    "facets",
    "filters",
    "highlighting",
    "typescript",
    "scout",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/scout/",
  "peerDependencies": {
    "@priemskiyyy/scout": ">=0.1.0 <0.2",
    "typesense": ">=3 <4"
  },
  "devDependencies": {
    "@priemskiyyy/scout": "workspace:*"
  }
}
