{
  "name": "scout-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './packages/internal/*' --filter './packages/adapters/*' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "dev:docs": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "lint:docs": "vue-tsc --noEmit -p docs/tsconfig.json",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm lint:prettier && pnpm test:unit && pnpm test:mutation && pnpm -r --filter './examples/*' --filter '!example-expo' build",
    "test:mutation": "node scripts/mutate.mjs",
    "test:package": "node scripts/verify-packages.mjs",
    "test:backends": "node scripts/test-backends.mjs",
    "test:examples": "pnpm build && playwright test -c examples/playwright.config.ts",
    "verify:release": "node scripts/verify-release.mjs",
    "check:release": "pnpm check && pnpm run --if-present build:docs && pnpm test:package && pnpm verify:release && pnpm --filter example-expo build && pnpm --filter example-expo build:native"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "9.5.1",
    "@eslint/js": "9.39.4",
    "@opensearch-project/opensearch": "3.6.0",
    "@orama/orama": "3.1.18",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tanstack/query-core": "5.103.2",
    "@tanstack/react-query": "5.103.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "algoliasearch": "5.59.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-vue": "10.11.0",
    "fuse.js": "7.5.0",
    "jsdom": "27.4.0",
    "meilisearch": "0.62.0",
    "minisearch": "7.2.0",
    "mongodb": "7.6.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "typesense": "3.0.6",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
